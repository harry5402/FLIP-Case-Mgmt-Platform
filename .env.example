DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require"
DATABASE_SSL=true
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS="http://localhost:3000"
SESSION_TTL_HOURS=12
IDLE_TIMEOUT_MINUTES=60
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=15
UPLOAD_MAX_FILE_MB=10
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-me-before-production"
DOCKETBIRD_API_TOKEN="replace-with-docketbird-bearer-token"

# Microsoft Graph API (email integration)
MS_CLIENT_ID="replace-with-azure-app-client-id"
MS_TENANT_ID="replace-with-azure-tenant-id"
MS_CLIENT_SECRET="replace-with-azure-client-secret"

# Anthropic (Claude)
ANTHROPIC_API_KEY="replace-with-anthropic-api-key"

# App
APP_URL="http://localhost:3000"
